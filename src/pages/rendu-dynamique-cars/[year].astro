---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import cars from "../../assets/cars.json";

export const prerender = false;

const { year } = Astro.params;
const selectedYear = Number(year ?? "0");
const filteredCars = cars.filter((car) => new Date(car.Year).getFullYear() === selectedYear);

if (!filteredCars.length) {
  return Astro.redirect("/rendu-dynamique-cars/");
}

const plotOptions = {
  height: 520,
  grid: true,
  style: { background: "transparent", color: "#fff8f5" },
  x: { label: "Poids (lb)" },
  y: { label: "Puissance (hp)" },
  marks: [
    Plot.dot(filteredCars, {
      x: "Weight_in_lbs",
      y: "Horsepower",
      fill: "#8fd3ff",
      r: 5,
      fillOpacity: 0.8
    })
  ]
};
---

<Layout title={`Cars ${selectedYear} — Rendu dynamique`}>
  <main class="mx-auto max-w-6xl px-6 py-12 lg:py-16">
    <a href="/rendu-dynamique-cars/" class="text-sm font-bold text-[#8fd3ff]">← Toutes les années</a>
    <header class="py-16">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[#8fd3ff]">Rendu dynamique</p>
      <h1 class="text-5xl font-bold text-[#fff8f5] md:text-7xl">Cars {selectedYear}</h1>
      <p class="mt-5 text-lg text-[#e6d6da]">{filteredCars.length} voiture(s) trouvée(s) pour cette année.</p>
    </header>
    <div class="overflow-hidden rounded-2xl border border-[#3d4f5b] bg-[#14212a] p-5">
      <PlotFigure options={plotOptions} />
    </div>
  </main>
</Layout>
