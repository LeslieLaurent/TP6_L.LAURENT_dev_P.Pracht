---
import Layout from "../layouts/Layout.astro";
---

<Layout title="TP Observable Plot - Client">

  <main class="mx-auto max-w-7xl px-6 py-16 lg:px-10">

    <section class="py-16">

      <p
        class="mb-4 text-sm font-bold uppercase
               tracking-[0.2em] text-[#ff9bb2]"
      >
        Astro × Observable Plot
      </p>

      <h1
        class="max-w-5xl text-6xl font-bold
               leading-[0.95] tracking-tight
               text-[#fff8f5]
               md:text-8xl"
      >
        Graphiques

        <span class="block text-[#ff9bb2]">
          côté client.
        </span>
      </h1>

      <p
        class="mt-7 max-w-2xl text-lg
               leading-8 text-[#e6d6da]"
      >
        Plusieurs essais permettent de comprendre
        comment générer et mettre à jour un graphique
        Observable Plot directement dans le navigateur.
      </p>

    </section>


    <section class="pb-20">

      <div class="grid gap-6 md:grid-cols-2">

        <a
          href="/rendu-dynamique/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#704052]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#ff9bb2]"
        >

          <span
            class="mb-14 font-bold
                   text-[#ff9bb2]"
          >
            01
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#ffd0db]"
          >
            Astro.params
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Rendu dynamique
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            Une route paramétrique rendue
            à la demande pour chaque espèce.
          </p>

        </a>

        <a
          href="/rendu-statique/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#355c50]
                 bg-[#12221d] p-8
                 transition hover:-translate-y-1
                 hover:border-[#7ee0c3]"
        >

          <span
            class="mb-14 font-bold
                   text-[#7ee0c3]"
          >
            02
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#b8f4e3]"
          >
            getStaticPaths
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Rendu statique
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            Les pages par espèce sont
            générées pendant le build.
          </p>

        </a>

      </div>

    </section>

    <section class="grid gap-6 md:grid-cols-2" aria-label="Autres datasets">

      <article class="rounded-3xl border border-[#3d4f5b] bg-[#14212a] p-8">
        <p class="text-sm font-bold uppercase tracking-[0.15em] text-[#8fd3ff]">Dataset Cars</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fff8f5]">Voitures</h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/rendu-dynamique-cars/" class="border border-[#8fd3ff] px-4 py-3 font-bold text-[#c7eaff] transition hover:bg-[#8fd3ff] hover:text-[#14212a]">
            Rendu dynamique
          </a>
          <a href="/rendu-statique-cars/" class="border border-[#3d4f5b] px-4 py-3 font-bold text-[#c4d6e2] transition hover:border-[#8fd3ff] hover:text-[#c7eaff]">
            Rendu statique
          </a>
        </div>
      </article>

      <article class="rounded-3xl border border-[#35584f] bg-[#11241f] p-8">
        <p class="text-sm font-bold uppercase tracking-[0.15em] text-[#7ee0c3]">Dataset Stocks</p>
        <h2 class="mt-3 text-3xl font-bold text-[#fff8f5]">Marchés financiers</h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/rendu-dynamique-stocks/" class="border border-[#7ee0c3] px-4 py-3 font-bold text-[#b8f4e3] transition hover:bg-[#7ee0c3] hover:text-[#11241f]">
            Rendu dynamique
          </a>
          <a href="/rendu-statique-stocks/" class="border border-[#35584f] px-4 py-3 font-bold text-[#c6ddd6] transition hover:border-[#7ee0c3] hover:text-[#b8f4e3]">
            Rendu statique
          </a>
        </div>
      </article>

    </section>

  </main>

</Layout>