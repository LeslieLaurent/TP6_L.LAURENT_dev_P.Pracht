---
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const species = [...new Set(penguins.map((penguin) => penguin.species))];

const colors = {
  Adelie: "#ff9bb2",
  Chinstrap: "#8fd3ff",
  Gentoo: "#7ee0c3"
};
---

<Layout title="Tous les Penguins — Observable Plot">
  <main class="mx-auto max-w-7xl px-6 py-12 lg:px-10 lg:py-16">
    <a href="/" class="text-sm font-bold text-[#ff9bb2] transition hover:text-[#ffd0db]">
      ← Retour à l'accueil
    </a>

    <header class="max-w-3xl py-16">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[#ff9bb2]">
        TP — Boucle et dataset
      </p>
      <h1 class="text-5xl font-bold leading-tight text-[#fff8f5] md:text-7xl">
        Tous les Penguins
      </h1>
      <p class="mt-5 text-lg leading-8 text-[#e6d6da]">
        Un graphique est généré pour chaque espèce grâce à une boucle Astro.
      </p>
    </header>

    <section class="grid gap-8 lg:grid-cols-3" aria-label="Graphiques des espèces">
      {species.map((currentSpecies) => {
        const filteredPenguins = penguins.filter((penguin) => penguin.species === currentSpecies);
        const plotOptions = {
          height: 360,
          grid: true,
          style: { background: "transparent", color: "#fff8f5" },
          x: { label: "Longueur du bec (mm)" },
          y: { label: "Profondeur du bec (mm)" },
          marks: [
            Plot.dot(filteredPenguins, {
              x: "culmen_length_mm",
              y: "culmen_depth_mm",
              fill: colors[currentSpecies as keyof typeof colors],
              r: 5,
              fillOpacity: 0.8
            })
          ]
        };

        return (
          <article class="border-t-2 border-[#704052] pt-5">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-2xl font-bold text-[#fff8f5]">{currentSpecies}</h2>
              <span class="text-sm text-[#cbb8be]">{filteredPenguins.length} individus</span>
            </div>
            <div class="mt-5 overflow-hidden rounded-xl border border-[#4b2936] bg-[#21131b] p-3">
              <PlotFigure options={plotOptions} />
            </div>
          </article>
        );
      })}
    </section>
  </main>
</Layout>
