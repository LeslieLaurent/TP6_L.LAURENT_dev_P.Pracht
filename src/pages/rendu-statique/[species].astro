---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";

export function getStaticPaths() {
  const species = [...new Set(penguins.map((penguin) => penguin.species))];
  return species.map((currentSpecies) => ({
    params: { species: currentSpecies.toLowerCase() },
    props: { selectedSpecies: currentSpecies }
  }));
}

const { selectedSpecies } = Astro.props;
const filteredPenguins = penguins.filter((penguin) => penguin.species === selectedSpecies);

const plotOptions = {
  height: 520,
  grid: true,
  style: { background: "transparent", color: "#fff8f5" },
  x: { label: "Longueur du bec (mm)" },
  y: { label: "Profondeur du bec (mm)" },
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      fill: "#7ee0c3",
      r: 5,
      fillOpacity: 0.8
    })
  ]
};
---

<Layout title={`${selectedSpecies} — Rendu statique`}>
  <main class="mx-auto max-w-6xl px-6 py-12 lg:py-16">
    <a href="/rendu-statique/" class="text-sm font-bold text-[#7ee0c3]">← Toutes les espèces</a>
    <header class="py-16">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.22em] text-[#7ee0c3]">Rendu statique</p>
      <h1 class="text-5xl font-bold text-[#fff8f5] md:text-7xl">{selectedSpecies}</h1>
      <p class="mt-5 text-lg text-[#e6d6da]">{filteredPenguins.length} individus trouvés pour cette espèce.</p>
    </header>
    <div class="overflow-hidden rounded-2xl border border-[#355c50] bg-[#12221d] p-5">
      <PlotFigure options={plotOptions} />
    </div>
  </main>
</Layout>
